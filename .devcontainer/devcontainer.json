{
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly",
    "source=claude-data,target=/home/vscode/.claude,type=volume"
  ],
  "features": {
    "ghcr.io/stu-bell/devcontainer-features/claude-code:0": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "predictionmirrortrader",
      "webPort": "6080"
    }
  },
  "containerEnv": {
    "HOST_PROJECT_PATH": "${localWorkspaceFolder}",
    "CONTAINER_WORKSPACE_FOLDER": "${containerWorkspaceFolder}"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-python.python-environment-manager",
        "charliermarsh.ruff",
        "saoudrizwan.claude-dev",
        "GitHub.copilot",
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
          }
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "sudo chmod 666 /var/run/docker-host.sock 2>/dev/null || true; if [ \"$CODESPACES\" = \"true\" ] && ! grep -q 'HOST_PROJECT_PATH override' ~/.bashrc 2>/dev/null; then echo '# HOST_PROJECT_PATH override for Codespaces docker-outside-of-docker\nexport HOST_PROJECT_PATH=\"$CONTAINER_WORKSPACE_FOLDER\"' >> ~/.bashrc; fi"
}