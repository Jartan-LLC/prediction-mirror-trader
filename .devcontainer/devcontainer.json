{
  "image": "mcr.microsoft.com/devcontainers/python@sha256:729bc20302313ef1159ec1e670ca53a2969ed8c720e023fc2bdda95f1644a8e0",
  "mounts": [
    "source=claude-data,target=/home/vscode/.claude,type=volume"
  ],
  "features": {
    // Installed as root, one stage before postCreateCommand — @anthropic-ai
    // ends up unwritable, so Claude Code's own auto-update fails. Accepted
    // trade-off: memcp carries the same shape, and pinning by digest closes
    // the root-at-build supply-chain path this feature ships from.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "predictionmirrortrader",
      "webPort": "6080"
    }
  },
  "containerEnv": {
    "HOST_PROJECT_PATH": "${localWorkspaceFolder}",
    "CONTAINER_WORKSPACE_FOLDER": "${containerWorkspaceFolder}"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-python.python-environment-manager",
        "charliermarsh.ruff",
        "saoudrizwan.claude-dev",
        "GitHub.copilot",
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
          }
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "sudo chmod 666 /var/run/docker-host.sock 2>/dev/null || true; if [ \"$CODESPACES\" = \"true\" ] && ! grep -q 'HOST_PROJECT_PATH override' ~/.bashrc 2>/dev/null; then echo '# HOST_PROJECT_PATH override for Codespaces docker-outside-of-docker\nexport HOST_PROJECT_PATH=\"$CONTAINER_WORKSPACE_FOLDER\"' >> ~/.bashrc; fi"
}